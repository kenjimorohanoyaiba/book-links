<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>準1級 想起トレーニング</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);

    /* ---- light (default) theme ---- */
    --bg: #EFE8D6;
    --bg-soft: #E6DDC5;
    --panel: #F8F3E4;
    --paper: #F1E4BC;
    --paper-edge: #E2D19E;
    --ink: #2C2013;
    --ink-soft: #5B5038;
    --text: #22201B;
    --text-dim: #6B6455;
    --line: rgba(44,32,19,0.14);
    --shadow: rgba(60,45,20,0.22);
    --gold: #A9761E;
    --gold-soft: #C79A3E;
    --good: #2E6B57;
    --good-bg: #DCEBE2;
    --hard: #9A6A16;
    --hard-bg: #F1E4C4;
    --bad: #9C3A28;
    --bad-bg: #F3DCD4;
    --accentline: #A9761E;
  }
  * { box-sizing: border-box; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  html, body { height: 100%; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #121A26;
      --bg-soft: #182333;
      --panel: #1B2534;
      --paper: #EDE1BC;
      --paper-edge: #D9C793;
      --ink: #2A2014;
      --ink-soft: #4E4530;
      --text: #E9E5D8;
      --text-dim: #9BA3B4;
      --line: rgba(255,255,255,0.09);
      --shadow: rgba(0,0,0,0.45);
      --gold: #DCAE48;
      --gold-soft: #E8C066;
      --good: #55B79A;
      --good-bg: #1E3A34;
      --hard: #E0AE4F;
      --hard-bg: #3A311D;
      --bad: #E17557;
      --bad-bg: #3B241E;
      --accentline: #DCAE48;
    }
  }
  :root[data-theme="dark"] {
    --bg: #121A26;
    --bg-soft: #182333;
    --panel: #1B2534;
    --paper: #EDE1BC;
    --paper-edge: #D9C793;
    --ink: #2A2014;
    --ink-soft: #4E4530;
    --text: #E9E5D8;
    --text-dim: #9BA3B4;
    --line: rgba(255,255,255,0.09);
    --shadow: rgba(0,0,0,0.45);
    --gold: #DCAE48;
    --gold-soft: #E8C066;
    --good: #55B79A;
    --good-bg: #1E3A34;
    --hard: #E0AE4F;
    --hard-bg: #3A311D;
    --bad: #E17557;
    --bad-bg: #3B241E;
    --accentline: #DCAE48;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Zen Kaku Gothic New', 'Hiragino Sans', sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100%;
  }
  ::selection { background: var(--gold-soft); color: #1a1408; }

  a, button, input, select { font-family: inherit; }
  button { cursor: pointer; }

  .app {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 20px calc(48px + env(safe-area-inset-bottom, 0px));
  }

  /* ---------- header ---------- */
  header.top {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--bg);
    padding: 16px 0 10px;
    border-bottom: 1px solid var(--line);
  }
  .top-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .brand {
    font-family: 'Shippori Mincho', serif;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.02em;
    color: var(--text);
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
  }
  .brand small {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-weight: 500;
    font-size: 11px;
    color: var(--text-dim);
  }
  .top-actions { display: flex; align-items: center; gap: 10px; }
  .streak-pill {
    display: flex; align-items: center; gap: 5px;
    font-size: 13px; font-weight: 700; color: var(--gold);
    background: color-mix(in srgb, var(--gold) 14%, transparent);
    padding: 5px 10px 5px 8px; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--gold) 30%, transparent);
  }
  .icon-btn {
    width: 34px; height: 34px; border-radius: 10px;
    border: 1px solid var(--line); background: var(--panel);
    color: var(--text); font-size: 16px;
    display: flex; align-items: center; justify-content: center;
  }
  nav.tabs {
    display: flex; gap: 4px; margin-top: 14px;
    overflow-x: auto; -ms-overflow-style: none; scrollbar-width: none;
  }
  nav.tabs::-webkit-scrollbar { display: none; }
  nav.tabs button {
    flex: none;
    border: none; background: transparent;
    color: var(--text-dim);
    font-size: 14px; font-weight: 700;
    padding: 8px 12px 10px;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  nav.tabs button.active { color: var(--text); border-bottom-color: var(--accentline); }

  section.view { display: none; padding-top: 22px; }
  section.view.active { display: block; }

  h2.section-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 18px; font-weight: 700;
    margin: 0 0 4px;
  }
  p.section-sub { margin: 0 0 18px; color: var(--text-dim); font-size: 13px; }

  /* ---------- settings popover ---------- */
  .popover-wrap { position: relative; }
  .popover {
    position: absolute; right: 0; top: calc(100% + 8px);
    width: 250px; background: var(--panel);
    border: 1px solid var(--line); border-radius: 14px;
    box-shadow: 0 12px 30px var(--shadow);
    padding: 16px; z-index: 30;
    display: none;
  }
  .popover.open { display: block; }
  .popover label {
    display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 6px; font-weight: 700;
  }
  .popover input[type=number] {
    width: 100%; padding: 8px 10px; border-radius: 8px;
    border: 1px solid var(--line); background: var(--bg); color: var(--text);
    font-size: 14px; margin-bottom: 14px;
  }
  .popover .row3 { display: flex; gap: 6px; margin-bottom: 14px; }
  .popover .row3 button {
    flex: 1; padding: 7px 0; border-radius: 8px; border: 1px solid var(--line);
    background: var(--bg); color: var(--text-dim); font-size: 12px; font-weight: 700;
  }
  .popover .row3 button.active { color: var(--bg); background: var(--gold); border-color: var(--gold); }
  .btn-danger-text {
    width: 100%; padding: 9px 0; border-radius: 8px;
    border: 1px solid var(--bad); background: transparent; color: var(--bad);
    font-size: 12px; font-weight: 700;
  }

  /* ---------- session ---------- */
  .session-stats {
    display: flex; gap: 18px; margin-bottom: 18px; font-size: 13px; color: var(--text-dim);
  }
  .session-stats b { color: var(--text); font-size: 15px; }
  .progress-track {
    height: 5px; border-radius: 3px; background: var(--line); overflow: hidden; margin-bottom: 26px;
  }
  .progress-fill { height: 100%; background: var(--accentline); width: 0%; transition: width .3s ease; }

  .stage-label {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 700; color: var(--gold);
    background: color-mix(in srgb, var(--gold) 12%, transparent);
    padding: 4px 10px; border-radius: 999px; margin-bottom: 16px;
  }

  .card-stage { display: flex; justify-content: center; padding: 6px 0 8px; }
  .flashcard {
    width: 100%; max-width: 420px;
    background: var(--paper); color: var(--ink);
    border-radius: 4px;
    border: 1px solid var(--paper-edge);
    box-shadow: 0 18px 36px var(--shadow), 0 2px 0 var(--paper-edge);
    padding: 30px 26px 26px;
    min-height: 260px;
    position: relative;
    transform: rotate(-0.6deg);
    display: flex; flex-direction: column;
  }
  .flashcard::before {
    content: ""; position: absolute; inset: 8px;
    border: 1px dashed color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 2px; pointer-events: none;
  }
  .card-pos {
    align-self: flex-start;
    font-size: 11px; font-weight: 700; letter-spacing: .02em;
    color: var(--ink-soft);
    border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: 4px; padding: 2px 7px; margin-bottom: 22px;
  }
  .card-word {
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    font-size: clamp(26px, 6vw, 34px);
    line-height: 1.3;
    text-align: center;
    margin: 0 0 6px;
    word-break: break-word;
  }
  .card-hint {
    text-align: center; font-size: 12px; color: var(--ink-soft);
    margin-top: auto; padding-top: 20px;
  }
  .card-answer { display: none; margin-top: 4px; }
  .flashcard.revealed .card-answer { display: block; }
  .flashcard.revealed .card-hint { display: none; }
  .card-meaning {
    font-family: 'Shippori Mincho', serif;
    font-size: 21px; font-weight: 700; text-align: center;
    margin: 6px 0 16px;
  }
  .card-divider { height: 1px; background: color-mix(in srgb, var(--ink) 16%, transparent); margin: 0 0 14px; }
  .card-example {
    font-size: 14px; line-height: 1.7; color: var(--ink-soft); text-align: left;
  }
  .card-example .hl { font-weight: 700; color: var(--ink); font-style: normal; text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 2px; }
  .card-note {
    margin-top: 12px; display: inline-block; font-size: 11.5px; font-weight: 700;
    color: var(--ink-soft); background: color-mix(in srgb, var(--ink) 8%, transparent);
    padding: 3px 9px; border-radius: 999px;
  }

  .reveal-btn {
    width: 100%; max-width: 420px; margin: 22px auto 0; display: block;
    padding: 15px 0; border-radius: 12px; border: none;
    background: var(--gold); color: #1c1608; font-weight: 900; font-size: 15px;
    letter-spacing: .01em;
  }
  .reveal-btn .key { opacity: .65; font-weight: 700; font-size: 12px; margin-left: 6px; }

  .grade-row {
    display: flex; gap: 8px; max-width: 420px; margin: 22px auto 0;
  }
  .grade-btn {
    flex: 1; border-radius: 12px; border: 1px solid var(--line);
    padding: 13px 4px 11px; text-align: center; background: var(--panel);
  }
  .grade-btn .g-label { display: block; font-weight: 800; font-size: 13.5px; }
  .grade-btn .g-key { display: block; font-size: 10.5px; color: var(--text-dim); margin-top: 3px; }
  .grade-btn.bad { border-color: color-mix(in srgb, var(--bad) 45%, var(--line)); }
  .grade-btn.bad .g-label { color: var(--bad); }
  .grade-btn.hard { border-color: color-mix(in srgb, var(--hard) 45%, var(--line)); }
  .grade-btn.hard .g-label { color: var(--hard); }
  .grade-btn.good { border-color: color-mix(in srgb, var(--good) 45%, var(--line)); }
  .grade-btn.good .g-label { color: var(--good); }

  .session-empty, .session-summary {
    max-width: 420px; margin: 10px auto 0; text-align: center;
    background: var(--panel); border: 1px solid var(--line); border-radius: 16px;
    padding: 34px 24px;
  }
  .session-empty .big-emoji, .session-summary .big-emoji { font-size: 30px; margin-bottom: 10px; }
  .session-empty h3, .session-summary h3 {
    font-family: 'Shippori Mincho', serif; font-size: 19px; margin: 0 0 8px;
  }
  .session-empty p, .session-summary p { color: var(--text-dim); font-size: 13.5px; margin: 0 0 20px; line-height: 1.6; }
  .summary-stats { display: flex; justify-content: center; gap: 26px; margin-bottom: 22px; }
  .summary-stats div b { display: block; font-size: 22px; font-family: 'Shippori Mincho', serif; }
  .summary-stats div span { font-size: 11.5px; color: var(--text-dim); }
  .btn-primary {
    display: inline-block; width: 100%; padding: 13px 0; border-radius: 12px;
    border: none; background: var(--accentline); color: var(--bg); font-weight: 800; font-size: 14px;
    margin-bottom: 10px;
  }
  .btn-secondary {
    display: inline-block; width: 100%; padding: 12px 0; border-radius: 12px;
    border: 1px solid var(--line); background: transparent; color: var(--text); font-weight: 700; font-size: 13.5px;
  }

  /* ---------- word bank ---------- */
  .wb-controls { margin-bottom: 16px; }
  .search-box {
    width: 100%; padding: 11px 14px; border-radius: 10px;
    border: 1px solid var(--line); background: var(--panel); color: var(--text);
    font-size: 14px; margin-bottom: 12px;
  }
  .chip-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 4px; }
  .chip {
    padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line);
    background: var(--panel); color: var(--text-dim); font-size: 12.5px; font-weight: 700;
  }
  .chip.active { background: var(--accentline); color: var(--bg); border-color: var(--accentline); }

  .add-toggle {
    width: 100%; padding: 12px 0; margin: 14px 0 6px; border-radius: 10px;
    border: 1px dashed var(--line); background: transparent; color: var(--text-dim);
    font-size: 13px; font-weight: 700;
  }
  .add-form {
    display: none; background: var(--panel); border: 1px solid var(--line); border-radius: 14px;
    padding: 16px; margin: 10px 0 18px;
  }
  .add-form.open { display: block; }
  .add-form .frow { margin-bottom: 10px; }
  .add-form label { display: block; font-size: 11.5px; color: var(--text-dim); font-weight: 700; margin-bottom: 5px; }
  .add-form input, .add-form select, .add-form textarea {
    width: 100%; padding: 9px 11px; border-radius: 8px; border: 1px solid var(--line);
    background: var(--bg); color: var(--text); font-size: 13.5px;
  }
  .add-form textarea { resize: vertical; min-height: 52px; }
  .add-form .frow2 { display: flex; gap: 10px; }
  .add-form .frow2 > div { flex: 1; }

  .word-list { border-top: 1px solid var(--line); }
  .word-row {
    padding: 13px 2px; border-bottom: 1px solid var(--line); cursor: pointer;
  }
  .word-row-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .word-row-word { font-family: 'Courier Prime', monospace; font-weight: 700; font-size: 15px; }
  .word-row-meaning { font-size: 12.5px; color: var(--text-dim); margin-top: 3px; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .status-dot.new { background: var(--text-dim); }
  .status-dot.learning { background: var(--hard); }
  .status-dot.retained { background: var(--gold); }
  .status-dot.mastered { background: var(--good); }
  .status-dot.leech { background: var(--bad); }
  .word-row-detail { display: none; margin-top: 10px; font-size: 13.5px; line-height: 1.7; color: var(--text-dim); }
  .word-row.open .word-row-detail { display: block; }
  .word-row-detail .hl { color: var(--text); font-weight: 700; }
  .row-actions { margin-top: 10px; display: flex; gap: 8px; }
  .row-actions button {
    font-size: 11.5px; font-weight: 700; padding: 5px 10px; border-radius: 7px;
    border: 1px solid var(--line); background: var(--bg); color: var(--text-dim);
  }
  .row-actions button.del { color: var(--bad); border-color: color-mix(in srgb, var(--bad) 40%, var(--line)); }
  .empty-note { text-align: center; padding: 30px 0; color: var(--text-dim); font-size: 13.5px; }

  /* ---------- compare ---------- */
  .group-select {
    width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid var(--line);
    background: var(--panel); color: var(--text); font-size: 14px; margin-bottom: 18px; font-weight: 700;
  }
  .compare-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
  @media (min-width: 560px) { .compare-grid { grid-template-columns: 1fr 1fr; } }
  .compare-card {
    background: var(--paper); color: var(--ink); border: 1px solid var(--paper-edge);
    border-radius: 10px; padding: 16px;
  }
  .compare-card .cw { font-family: 'Courier Prime', monospace; font-weight: 700; font-size: 17px; }
  .compare-card .cp { font-size: 10.5px; color: var(--ink-soft); font-weight: 700; margin-left: 6px; }
  .compare-card .cm { font-family: 'Shippori Mincho', serif; font-weight: 700; font-size: 15px; margin: 6px 0 8px; }
  .compare-card .ce { font-size: 12.5px; color: var(--ink-soft); line-height: 1.6; }
  .compare-card .ce .hl { font-weight: 700; color: var(--ink); text-decoration: underline; text-decoration-color: var(--gold); }

  /* ---------- stats ---------- */
  .stat-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 26px;
  }
  @media (min-width: 480px) { .stat-grid { grid-template-columns: repeat(3, 1fr); } }
  .stat-card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 16px;
  }
  .stat-card b { display: block; font-family: 'Shippori Mincho', serif; font-size: 24px; }
  .stat-card span { font-size: 12px; color: var(--text-dim); }
  .bar-list { display: flex; flex-direction: column; gap: 8px; }
  .bar-row { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--text-dim); }
  .bar-row .lbl { width: 68px; flex: none; }
  .bar-row .track { flex: 1; height: 12px; background: var(--line); border-radius: 6px; overflow: hidden; }
  .bar-row .fill { height: 100%; background: var(--accentline); }
  .bar-row .val { width: 26px; flex: none; text-align: right; color: var(--text); font-weight: 700; }

  footer.foot {
    text-align: center; padding: 30px 0 6px; font-size: 11.5px; color: var(--text-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
  .visually-hidden { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }
</style>
</head>
<body>

<div class="app">
  <header class="top">
    <div class="top-row">
      <div class="brand">準1級<small>想起トレーニング</small></div>
      <div class="top-actions">
        <div class="streak-pill">🔥 <span id="streakCount">0</span></div>
        <div class="popover-wrap">
          <button class="icon-btn" id="settingsBtn" aria-label="設定">⚙</button>
          <div class="popover" id="settingsPopover">
            <label for="newPerDayInput">1日の新規語数</label>
            <input type="number" id="newPerDayInput" min="5" max="40" step="1">
            <label>テーマ</label>
            <div class="row3">
              <button data-theme-choice="system">自動</button>
              <button data-theme-choice="light">ライト</button>
              <button data-theme-choice="dark">ダーク</button>
            </div>
            <button class="btn-danger-text" id="resetAllBtn">学習データをリセット</button>
          </div>
        </div>
      </div>
    </div>
    <nav class="tabs">
      <button data-tab="session" class="active">今日の学習</button>
      <button data-tab="wordbank">単語帳</button>
      <button data-tab="compare">比較</button>
      <button data-tab="stats">統計</button>
    </nav>
  </header>

  <!-- ================= SESSION ================= -->
  <section class="view active" id="view-session">
    <div id="sessionRoot"></div>
  </section>

  <!-- ================= WORD BANK ================= -->
  <section class="view" id="view-wordbank">
    <h2 class="section-title">単語帳</h2>
    <p class="section-sub">見出し語をタップすると意味と例文を確認できます。長文で出会った単語もここから追加しましょう。</p>
    <div class="wb-controls">
      <input type="text" class="search-box" id="wbSearch" placeholder="単語・意味で検索">
      <div class="chip-row" id="wbFilters">
        <button class="chip active" data-filter="all">すべて</button>
        <button class="chip" data-filter="new">新規</button>
        <button class="chip" data-filter="learning">学習中</button>
        <button class="chip" data-filter="mastered">習得済み</button>
        <button class="chip" data-filter="leech">苦手</button>
      </div>
    </div>
    <button class="add-toggle" id="addToggleBtn">＋ 単語を追加する（長文で見つけた語など）</button>
    <div class="add-form" id="addForm">
      <div class="frow">
        <label>英単語</label>
        <input type="text" id="fWord" placeholder="例：ambiguous">
      </div>
      <div class="frow2">
        <div class="frow">
          <label>品詞</label>
          <select id="fPos">
            <option value="形">形容詞</option>
            <option value="動">動詞</option>
            <option value="名">名詞</option>
            <option value="副">副詞</option>
            <option value="句">句・熟語</option>
          </select>
        </div>
        <div class="frow">
          <label>グループ（任意）</label>
          <input type="text" id="fGroup" placeholder="例：似た単語のタグ">
        </div>
      </div>
      <div class="frow">
        <label>意味</label>
        <input type="text" id="fMeaning" placeholder="例：あいまいな">
      </div>
      <div class="frow">
        <label>例文</label>
        <textarea id="fExample" placeholder="その単語を使った英文を入れておくと定着しやすくなります"></textarea>
      </div>
