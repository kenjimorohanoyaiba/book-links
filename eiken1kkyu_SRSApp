function daysBetween(a,b){
  var da = new Date(a+"T00:00:00"), db = new Date(b+"T00:00:00");
  return Math.round((db-da)/86400000);
}

var defaultState = {
  cards: {},
  custom: [],
  settings: { newPerDay: 15, theme: "system" },
  today: { date: todayStr(), newIntroduced: 0 },
  streak: { count: 0, lastDate: null },
  log: {}
};

var state = loadState();

function loadState(){
  try {
    var raw = localStorage.getItem(STORE_KEY);
    if (!raw) return JSON.parse(JSON.stringify(defaultState));
    var parsed = JSON.parse(raw);
    parsed.cards = parsed.cards || {};
    parsed.custom = parsed.custom || [];
    parsed.settings = Object.assign({newPerDay:15,theme:"system"}, parsed.settings||{});
    parsed.today = parsed.today || {date: todayStr(), newIntroduced:0};
    parsed.streak = parsed.streak || {count:0,lastDate:null};
    parsed.log = parsed.log || {};
    return parsed;
  } catch(e){
    console.error("state load failed", e);
    return JSON.parse(JSON.stringify(defaultState));
  }
}
function saveState(){
  try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); }
  catch(e){ console.error("state save failed", e); }
}

function allWords(){
  return VOCAB.concat(state.custom);
}
function wordById(id){
  var found = null;
  allWords().forEach(function(w){ if (w.id === id) found = w; });
  return found;
}
function cardState(id){
  if (!state.cards[id]) {
    state.cards[id] = { box:0, next:null, seen:false, reps:0, lapses:0, lastGrade:null };
  }
  return state.cards[id];
}

function rollDailyIfNeeded(){
  var t = todayStr();
  if (state.today.date !== t) {
    state.today = { date: t, newIntroduced: 0 };
    saveState();
  }
}

function bumpStreakOnActivity(){
  var t = todayStr();
  if (state.streak.lastDate === t) return;
  if (state.streak.lastDate) {
    var gap = daysBetween(state.streak.lastDate, t);
    state.streak.count = (gap === 1) ? state.streak.count + 1 : 1;
  } else {
    state.streak.count = 1;
  }
  state.streak.lastDate = t;
  saveState();
}

function logToday(field, n){
  var t = todayStr();
  if (!state.log[t]) state.log[t] = {reviewed:0, newCount:0, correct:0};
  state.log[t][field] += n;
}

/* ================= 語のステータス判定 ================= */
function statusOf(id){
  var cs = cardState(id);
  if (!cs.seen) return "new";
  if (cs.lapses >= 3) return "leech";
  if (cs.box >= 6) return "mastered";
  if (cs.box >= 4) return "retained";
  return "learning";
}
function isDue(id){
  var cs = cardState(id);
  if (!cs.seen) return false;
  if (!cs.next) return true;
  return cs.next <= todayStr();
}

function renderExample(tpl){
  return tpl.replace(/\{h\}/g,'<span class="hl">').replace(/\{\/h\}/g,'</span>');
}


/* ================= タブ切り替え ================= */
