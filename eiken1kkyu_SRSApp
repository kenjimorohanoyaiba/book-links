  });
}
function applyTheme(){
  var root = document.documentElement;
  if (state.settings.theme === "light") root.setAttribute("data-theme","light");
  else if (state.settings.theme === "dark") root.setAttribute("data-theme","dark");
  else root.removeAttribute("data-theme");
}
document.getElementById("resetAllBtn").addEventListener("click", function(){
  if (confirm("すべての学習データを削除します。よろしいですか？")) {
    try { localStorage.removeItem(STORE_KEY); } catch(e){}
    state = JSON.parse(JSON.stringify(defaultState));
    saveState();
    location.reload();
  }
});

/* ================= 学習セッション ================= */
var sessionRoot = document.getElementById("sessionRoot");
var sess = null; // { stage:'review'|'new'|'redo'|'done', queue:[...ids], pos, total, correctCount, missed:Set }

function buildDueQueue(){
  var ids = allWords().map(function(w){return w.id;}).filter(isDue);
  return shuffle(ids);
}
function buildNewQueue(){
  rollDailyIfNeeded();
  var remaining = state.settings.newPerDay - state.today.newIntroduced;
  if (remaining <= 0) return [];
  var unseen = allWords().map(function(w){return w.id;}).filter(function(id){ return !cardState(id).seen; });
  return unseen.slice(0, remaining);
}

function startSession(){
  rollDailyIfNeeded();
  var dueQ = buildDueQueue();
  var stage, queue;
  if (dueQ.length) {
    stage = "review";
    queue = dueQ;
  } else {
    var newQ = shuffle(buildNewQueue());
    stage = newQ.length ? "new" : "empty";
    queue = newQ;
  }
  sess = {
    stage: stage,
    queue: queue,
    total: queue.length,
    pos: 0,
    revealed: false,
    correctCount: 0,
    missedIds: [],
    newBatch: null
  };
  renderSession();
}

function shuffle(arr){
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i+1));
    var t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}

function currentCardId(){
  if (!sess || sess.pos >= sess.queue.length) return null;
  return sess.queue[sess.pos];
}

function grade(result){
  var id = currentCardId();
  if (!id) return;
  var cs = cardState(id);
  var wasNew = !cs.seen;
  cs.seen = true;
  cs.reps += 1;

  if (result === "bad") {
    cs.lapses += 1;
    cs.box = 0;
    cs.next = todayStr();
    sess.missedIds.push(id);
    // すぐの再挑戦のため、少し後ろに再挿入する
    var insertAt = Math.min(sess.queue.length, sess.pos + 3 + Math.floor(Math.random()*3));
    sess.queue.splice(insertAt, 0, id);
    sess.total = Math.max(sess.total, sess.queue.length);
  } else if (result === "hard") {
    cs.next = addDays(todayStr(), 1);
    sess.missedIds.push(id);
  } else { // good
    cs.box = Math.min(cs.box + 1, INTERVALS.length);
    cs.next = addDays(todayStr(), INTERVALS[cs.box - 1]);
    sess.correctCount += 1;
  }
  cs.lastGrade = result;

  if (wasNew) {
    state.today.newIntroduced += 1;
    logToday("newCount", 1);
  }
  logToday("reviewed", 1);
  if (result === "good") logToday("correct", 1);

  bumpStreakOnActivity();
  saveState();

  sess.pos += 1;
  sess.revealed = false;
  advanceSessionIfNeeded();
  renderSession();
}

function advanceSessionIfNeeded(){
  if (sess.pos < sess.queue.length) return; // まだカードが残っている
  if (sess.stage === "review") {
    sess.stage = "review-done"; // レビュー完了、新規に進むか選ばせる
  } else if (sess.stage === "new") {
    sess.stage = "done";
  } else if (sess.stage === "redo") {
    sess.stage = "done";
  }
}

function goToNewPhase(){
  var q = buildNewQueue();
  sess.stage = "new";
  sess.queue = shuffle(q);
  sess.total = q.length;
  sess.pos = 0;
  sess.revealed = false;
  renderSession();
}
function skipNewPhase(){
  sess.stage = "done";
  renderSession();
}
function startRedo(){
  var ids = sess.missedIds.slice();
  if (!ids.length) return;
  sess.stage = "redo";
  sess.queue = shuffle(ids);
  sess.total = sess.queue.length;
  sess.pos = 0;
  sess.revealed = false;
  sess.correctCount = 0;
  sess.missedIds = [];
  renderSession();
}

function esc(s){
  var d = document.createElement("div");
  d.textContent = s;
  return d.innerHTML;
}

function renderSession(){
  rollDailyIfNeeded();
  if (!sess) { startSession(); return; }

  if (sess.stage === "empty") {
    var dueCount = buildDueQueue().length;
    var newLeft = state.settings.newPerDay - state.today.newIntroduced;
    sessionRoot.innerHTML =
      '<div class="session-empty"><div class="big-emoji">☕</div>' +
      '<h3>今日の分は完了しています</h3>' +
      '<p>復習も新規もいったん終わりです。無理に増やさず、また明日続けましょう。'+
      (newLeft > 0 ? '' : '<br>今日の新規語の上限（'+state.settings.newPerDay+'語）に達しました。') +
      '</p></div>';
    return;
  }

  if (sess.stage === "review-done") {
    var newAvailable = buildNewQueue().length;
    sessionRoot.innerHTML =
      '<div class="session-summary"><div class="big-emoji">📖</div>' +
      '<h3>復習フェーズ終了</h3>' +
      '<div class="summary-stats"><div><b>'+sess.total+'</b><span>復習した語</span></div>' +
      '<div><b>'+sess.correctCount+'</b><span>思い出せた</span></div></div>' +
      (newAvailable > 0
        ? '<p>続けて新しい単語を学習しますか？（今日はあと '+newAvailable+' 語まで）</p>' +
          '<button class="btn-primary" id="toNewBtn">新しい単語に進む</button>' +
          '<button class="btn-secondary" id="skipNewBtn">今日はここまでにする</button>'
        : '<p>今日の新規語の上限に達しているか、未学習の単語がありません。</p>' +
          '<button class="btn-secondary" id="skipNewBtn">結果を見る</button>'
      ) + '</div>';
    if (newAvailable > 0) document.getElementById("toNewBtn").addEventListener("click", goToNewPhase);
    document.getElementById("skipNewBtn").addEventListener("click", skipNewPhase);
    return;
  }

  if (sess.stage === "done") {
    var canRedo = sess.missedIds.length > 0;
    sessionRoot.innerHTML =
      '<div class="session-summary"><div class="big-emoji">✅</div>' +
      '<h3>お疲れさまでした</h3>' +
      '<div class="summary-stats"><div><b>'+sess.total+'</b><span>取り組んだ語</span></div>' +
      '<div><b>'+sess.correctCount+'</b><span>すぐ思い出せた</span></div>' +
      '<div><b>'+sess.missedIds.length+'</b><span>要復習</span></div></div>' +
      (canRedo ? '<button class="btn-primary" id="redoBtn">苦手な単語だけもう一周（'+new Set(sess.missedIds).size+'語）</button>' : '') +
      '<button class="btn-secondary" id="restartBtn">セッション画面に戻る</button></div>';
    if (canRedo) document.getElementById("redoBtn").addEventListener("click", startRedo);
    document.getElementById("restartBtn").addEventListener("click", function(){ sess = null; startSession(); });
    return;
  }

  // review / new / redo: フラッシュカード表示
  var id = currentCardId();
  if (!id) { advanceSessionIfNeeded(); renderSession(); return; }
  var w = wordById(id);
  var stageLabel = sess.stage === "review" ? "復習フェーズ・シャッフル出題中"
                   : sess.stage === "new" ? "新規学習フェーズ"
                   : "苦手だけドリル中";
  var doneCount = sess.pos;
  var pct = sess.total ? Math.min(100, Math.round((doneCount / sess.total) * 100)) : 0;

  var html = '';
  html += '<span class="stage-label">'+stageLabel+'</span>';
  html += '<div class="session-stats"><div><b>'+(sess.total - doneCount)+'</b> 残り</div><div><b>'+doneCount+'</b> 完了</div><div><b>'+sess.correctCount+'</b> 正解</div></div>';
  html += '<div class="progress-track"><div class="progress-fill" style="width:'+pct+'%"></div></div>';
  html += '<div class="card-stage"><div class="flashcard'+(sess.revealed?' revealed':'')+'" id="flashcard">';
  html += '<span class="card-pos">'+esc(w.pos)+'</span>';
  html += '<div class="card-word">'+esc(w.word)+'</div>';
  html += '<div class="card-hint">タップ、またはEnter／Spaceキーで意味を表示</div>';
  html += '<div class="card-answer">';
  html += '<div class="card-meaning">'+esc(w.meaning)+'</div>';
  html += '<div class="card-divider"></div>';
  html += '<div class="card-example">'+renderExample(w.example)+'</div>';
  if (w.group) html += '<span class="card-note">似た単語グループあり</span>';
  html += '</div></div></div>';

  if (!sess.revealed) {
    html += '<button class="reveal-btn" id="revealBtn">答えを見る<span class="key">Enter / Space</span></button>';
  } else {
    html += '<div class="grade-row">';
    html += '<button class="grade-btn bad" id="gBad"><span class="g-label">わからなかった</span><span class="g-key">1</span></button>';
    html += '<button class="grade-btn hard" id="gHard"><span class="g-label">曖昧</span><span class="g-key">2</span></button>';
    html += '<button class="grade-btn good" id="gGood"><span class="g-label">完璧</span><span class="g-key">3</span></button>';
    html += '</div>';
  }

  sessionRoot.innerHTML = html;

  var fc = document.getElementById("flashcard");
  fc.addEventListener("click", reveal);
  if (!sess.revealed) {
    document.getElementById("revealBtn").addEventListener("click", reveal);
  } else {
    document.getElementById("gBad").addEventListener("click", function(){ grade("bad"); });
    document.getElementById("gHard").addEventListener("click", function(){ grade("hard"); });
    document.getElementById("gGood").addEventListener("click", function(){ grade("good"); });
  }
}

function reveal(){
  if (!sess || sess.revealed) return;
  sess.revealed = true;
  renderSession();
}

document.addEventListener("keydown", function(e){
  var sessionTab = document.getElementById("view-session");
  if (!sessionTab.classList.contains("active")) return;
  if (!sess) return;
  if (["review","new","redo"].indexOf(sess.stage) === -1) return;
  if (!sess.revealed) {
    if (e.code === "Enter" || e.code === "Space") { e.preventDefault(); reveal(); }
    return;
  }
  if (e.key === "1") grade("bad");
  else if (e.key === "2") grade("hard");
  else if (e.key === "3") grade("good");
});

/* ================= 単語帳タブ ================= */
var currentFilter = "all";
var searchQuery = "";

document.getElementById("wbSearch").addEventListener("input", function(e){
  searchQuery = e.target.value.trim().toLowerCase();
  renderWordBank();
});
document.querySelectorAll("#wbFilters .chip").forEach(function(chip){
  chip.addEventListener("click", function(){
    document.querySelectorAll("#wbFilters .chip").forEach(function(c){ c.classList.remove("active"); });
    chip.classList.add("active");
    currentFilter = chip.dataset.filter;
    renderWordBank();
  });
});

var addToggleBtn = document.getElementById("addToggleBtn");
var addForm = document.getElementById("addForm");
addToggleBtn.addEventListener("click", function(){
  addForm.classList.toggle("open");
});
document.getElementById("fSubmit").addEventListener("click", function(){
  var word = document.getElementById("fWord").value.trim();
  var meaning = document.getElementById("fMeaning").value.trim();
  var example = document.getElementById("fExample").value.trim();
  var pos = document.getElementById("fPos").value;
  var group = document.getElementById("fGroup").value.trim() || null;
  if (!word || !meaning) { alert("英単語と意味は必須です。"); return; }
  var id = "c_" + Date.now() + "_" + Math.floor(Math.random()*1000);
  state.custom.push({ id: id, word: word, pos: pos, meaning: meaning, example: example || word, group: group, custom: true });
  saveState();
  document.getElementById("fWord").value = "";
  document.getElementById("fMeaning").value = "";
  document.getElementById("fExample").value = "";
  document.getElementById("fGroup").value = "";
  addForm.classList.remove("open");
  renderWordBank();
});

function renderWordBank(){
  var list = document.getElementById("wordList");
  var words = allWords().filter(function(w){
    var st = statusOf(w.id);
    if (currentFilter !== "all") {
      if (currentFilter === "learning" && (st === "new" || st === "mastered")) return false;
      if (currentFilter !== "learning" && st !== currentFilter) return false;
    }
    if (searchQuery) {
      var hay = (w.word + " " + w.meaning).toLowerCase();
      if (hay.indexOf(searchQuery) === -1) return false;
    }
    return true;
  });

  if (!words.length) {
    list.innerHTML = '<div class="empty-note">該当する単語がありません。</div>';
    return;
  }

  var statusLabel = {new:"新規", learning:"学習中", retained:"定着中", mastered:"習得済み", leech:"苦手"};

  list.innerHTML = words.map(function(w){
    var st = statusOf(w.id);
    var delBtn = w.custom ? '<button class="del" data-del="'+w.id+'">削除</button>' : '';
    return (
      '<div class="word-row" data-id="'+w.id+'">' +
        '<div class="word-row-top">' +
          '<div><div class="word-row-word">'+esc(w.word)+' <span style="font-size:11px;color:var(--text-dim);font-weight:400;">'+esc(w.pos)+'</span></div>' +
          '<div class="word-row-meaning">'+esc(w.meaning)+'</div></div>' +
          '<div style="display:flex;align-items:center;gap:6px;"><span style="font-size:11px;color:var(--text-dim);">'+statusLabel[st]+'</span><span class="status-dot '+st+'"></span></div>' +
        '</div>' +
        '<div class="word-row-detail">' + renderExample(w.example) +
          '<div class="row-actions"><button data-reset="'+w.id+'">進捗をリセット</button>'+delBtn+'</div>' +
        '</div>' +
      '</div>'
    );
  }).join("");

  list.querySelectorAll(".word-row").forEach(function(row){
    row.addEventListener("click", function(e){
      if (e.target.closest("button")) return;
      row.classList.toggle("open");
    });
  });
  list.querySelectorAll("[data-reset]").forEach(function(btn){
    btn.addEventListener("click", function(e){
      e.stopPropagation();
      var id = btn.dataset.reset;
      state.cards[id] = { box:0, next:null, seen:false, reps:0, lapses:0, lastGrade:null };
      saveState();
      renderWordBank();
    });
  });
  list.querySelectorAll("[data-del]").forEach(function(btn){
    btn.addEventListener("click", function(e){
      e.stopPropagation();
      var id = btn.dataset.del;
      if (!confirm("この単語を単語帳から削除しますか？")) return;
      state.custom = state.custom.filter(function(w){ return w.id !== id; });
      delete state.cards[id];
      saveState();
      renderWordBank();
    });
  });
}

/* ================= 比較タブ ================= */
function groupsInUse(){
  var map = {};
  allWords().forEach(function(w){
    if (w.group) {
      if (!map[w.group]) map[w.group] = [];
      map[w.group].push(w);
    }
  });
  return map;
}
function renderCompare(){
  var sel = document.getElementById("groupSelect");
  var groups = groupsInUse();
  var keys = Object.keys(groups);
  if (!keys.length) {
    sel.innerHTML = '<option>グループがありません</option>';
    document.getElementById("compareGrid").innerHTML = '<div class="empty-note">単語追加時にグループ名を入れると、ここで比較できます。</div>';
    return;
  }
  var prevValue = sel.value;
  sel.innerHTML = keys.map(function(k){
    var label = GROUP_LABELS[k] || k;
    return '<option value="'+esc(k)+'">'+esc(label)+'（'+groups[k].length+'語）</option>';
  }).join("");
  if (keys.indexOf(prevValue) !== -1) sel.value = prevValue;
  sel.onchange = function(){ paintCompareGrid(groups[sel.value] || []); };
  paintCompareGrid(groups[sel.value] || groups[keys[0]]);
}
function paintCompareGrid(words){
  var grid = document.getElementById("compareGrid");
  grid.innerHTML = words.map(function(w){
    return (
      '<div class="compare-card">' +
        '<div><span class="cw">'+esc(w.word)+'</span><span class="cp">'+esc(w.pos)+'</span></div>' +
        '<div class="cm">'+esc(w.meaning)+'</div>' +
        '<div class="ce">'+renderExample(w.example)+'</div>' +
      '</div>'
    );
  }).join("");
}

/* ================= 統計タブ ================= */
function renderStats(){
  var words = allWords();
  var counts = {new:0, learning:0, retained:0, mastered:0, leech:0};
  words.forEach(function(w){ counts[statusOf(w.id)]++; });
  var dueToday = words.filter(function(w){ return isDue(w.id); }).length;

  var grid = document.getElementById("statGrid");
  grid.innerHTML = [
    ["総単語数", words.length],
    ["今日の復習", dueToday],
    ["学習中", counts.learning],
    ["定着中", counts.retained],
    ["習得済み", counts.mastered],
    ["苦手（要注意）", counts.leech]
  ].map(function(pair){
    return '<div class="stat-card"><b>'+pair[1]+'</b><span>'+pair[0]+'</span></div>';
  }).join("");

  var barList = document.getElementById("barList");
  var days = [];
  for (var i = 6; i >= 0; i--) days.push(addDays(todayStr(), -i));
  var maxVal = 1;
  days.forEach(function(d){ if (state.log[d]) maxVal = Math.max(maxVal, state.log[d].reviewed); });
  barList.innerHTML = days.map(function(d){
    var val = state.log[d] ? state.log[d].reviewed : 0;
    var pct = Math.round((val / maxVal) * 100);
    var label = d.slice(5).replace("-","/");
    return (
      '<div class="bar-row"><div class="lbl">'+label+'</div>' +
      '<div class="track"><div class="fill" style="width:'+pct+'%"></div></div>' +
      '<div class="val">'+val+'</div></div>'
    );
  }).join("");
}

/* ================= 初期化 ================= */
applyTheme();
updateThemeButtons();
document.getElementById("streakCount").textContent = state.streak.count;
rollDailyIfNeeded();
startSession();

})();
